{
    "compileOnSave": false,
    "compilerOptions": {
        "outDir": "./dist/out-tsc",
        "sourceMap": true,
        "declaration": false,
        "module": "preserve",
        "moduleResolution": "bundler",
        "experimentalDecorators": true,
        "importHelpers": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "target": "ES2022",
        "useDefineForClassFields": false,
        "lib": [
            "ES2022",
            "dom"
        ]
    }
}
